# Firebase Configuration
# Copy this to .env and fill in your Firebase project values
# Found in Firebase Console → Project Settings → Your Apps → Web App → SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Site Configuration
VITE_SITE_URL=https://JustJayDev.github.io/just-jay-site/
VITE_CANONICAL_URL=https://JustJayDev.github.io/just-jay-site/

# Analytics (optional)
VITE_ANALYTICS_ENABLED=true

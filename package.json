{
  "name": "justjaydev",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "gen:static": "node scripts/gen-static.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "test": "node --test scripts/test-content.mjs",
    "build": "tsc --noEmit && node scripts/validate-content.mjs && vite build && node scripts/gen-static.mjs && node scripts/check-build.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
